# .env.example
# Copy to .env and fill in. NEVER commit .env.

# ─── Provider ─────────────────────────────────────────────────────────────────
# Choose: anthropic | mistral
PROVIDER=anthropic

# ─── Anthropic ────────────────────────────────────────────────────────────────
# Required if PROVIDER=anthropic
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
# Options: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001

# ─── Mistral ──────────────────────────────────────────────────────────────────
# Required if PROVIDER=mistral
# Get key: https://console.mistral.ai
# ESR license (French universities): check your AMUE agreement
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest
# Options: mistral-large-latest | mistral-small-latest | open-mixtral-8x22b

# ─── Course Configuration ──────────────────────────────────────────────────────
INSTITUTION_NAME=Université Toulouse III – Paul Sabatier
COURSE_ID=M1-Biology-2025
TEACHER_ID=XX

# ─── Paths ────────────────────────────────────────────────────────────────────
# NOTE: not yet read by providers/mistral/session.py -- reserved for future use
OUTPUT_DIR=build/feedback
TRACKER_DIR=build/trackers

# ─── Feature Flags ────────────────────────────────────────────────────────────
# NOTE: not yet read by providers/mistral/session.py -- reserved for future use
ENABLE_AI_DETECTION=true
ENABLE_AUTOPILOT=false
DEBUG_ROUTING=false

# ─── Locale ───────────────────────────────────────────────────────────────────
# en | fr
AGENT_LANGUAGE=en
